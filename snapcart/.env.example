# Copy this file to .env.local and fill in your own values.

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/snapcart

# NextAuth: any long random string (e.g. run: npx auth secret)
AUTH_SECRET=change-me

# Google login (Google Cloud Console > Credentials > OAuth client)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (test mode keys). Webhook secret comes from: stripe listen --forward-to localhost:3000/api/user/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where this Next.js app runs, and where the socket server runs
NEXT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_SERVER=http://localhost:5000

# Shared secret between this app and socketServer (use the same value in socketServer/.env)
SOCKET_SECRET=change-me-too
